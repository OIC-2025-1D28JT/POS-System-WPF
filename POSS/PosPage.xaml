<Page x:Class="POSS.PosPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel Orientation="Horizontal"><TextBox x:Name="txtBarcode" Width="160" Margin="4" KeyDown="txtBarcode_KeyDown"/><TextBox x:Name="txtName" Width="180" Margin="4"/><TextBox x:Name="txtPrice" Width="100" Margin="4"/><ComboBox x:Name="txtQty" Width="70" Margin="4"><ComboBoxItem Content="1"/><ComboBoxItem Content="2"/><ComboBoxItem Content="3"/><ComboBoxItem Content="4"/><ComboBoxItem Content="5"/></ComboBox><Button x:Name="btnAdd" Content="追加" Margin="4" Padding="20,8" Click="btnAdd_Click"/></StackPanel><DataGrid x:Name="CartGrid" Grid.Row="1" Margin="0,16" AutoGenerateColumns="True"><DataGrid.RowDetailsTemplate><DataTemplate><Button Content="削除" Tag="{Binding}" Click="Delete_Click"/></DataTemplate></DataGrid.RowDetailsTemplate></DataGrid><StackPanel Grid.Row="2"><StackPanel Orientation="Horizontal"><TextBlock Text="商品数: "/><TextBlock x:Name="txtItemCount" Text="0点" Margin="0,0,30,0"/><TextBlock Text="小計: "/><TextBlock x:Name="txtSubTotal" Text="¥0" Margin="0,0,30,0"/><TextBlock Text="合計: "/><TextBlock x:Name="txtTotal" Text="¥0"/></StackPanel><StackPanel Orientation="Horizontal" Margin="0,12,0,0"><TextBlock Text="お預かり" VerticalAlignment="Center"/><TextBox x:Name="txtReceived" Width="120" Margin="8,0" TextChanged="txtReceived_TextChanged"/><TextBlock Text="お釣り" VerticalAlignment="Center"/><TextBox x:Name="txtChange" Width="120" Margin="8,0" IsReadOnly="True"/><Button x:Name="btnPayment" Content="会計完了" Padding="24,8" Click="btnPayment_Click"/></StackPanel></StackPanel></Grid></Page>